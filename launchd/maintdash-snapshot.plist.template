<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS scheduled monthly snapshot. Copy to
     ~/Library/LaunchAgents/com.YOURNAME.maintdash-snapshot.plist,
     replace the three __PLACEHOLDER__ values, then:
        launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.YOURNAME.maintdash-snapshot.plist
     Day/Hour/Minute below = 25th of each month at 09:00; edit to taste.
     PATH must contain the dir holding `gh` (e.g. /opt/homebrew/bin on Apple
     Silicon, /usr/local/bin on Intel). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.YOURNAME.maintdash-snapshot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__PROJECT_DIR__/maintdash.py</string>
    <string>snapshot</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key><integer>25</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>
  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/logs/snapshot.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/logs/snapshot.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
